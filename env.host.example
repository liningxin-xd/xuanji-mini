# Model/platform -> Xuanji Host authentication. Use at least 32 random bytes.
XUANJI_HOST_BEARER_TOKEN=
XUANJI_HOST_PUBLIC_URL=http://127.0.0.1:8091
XUANJI_HOST=127.0.0.1
XUANJI_PORT=8091
XUANJI_LOG_LEVEL=INFO
XUANJI_ANALYSIS_PROFILE=primary_v1

# Xuanji Host -> existing read-only DView MCP authentication.
XUANJI_DVIEW_MCP_URL=https://dview-mcp-public.tapsvc.com/mcp/query
XUANJI_DVIEW_BEARER_TOKEN=
XUANJI_DVIEW_READ_TIMEOUT_SECONDS=660

# Host-owned receipt authority. Use a different secret with at least 32 bytes.
XUANJI_RECEIPT_KEY_ID=xuanji-primary-host-v1
XUANJI_RECEIPT_SECRET=

# Mount one persistent volume here and run one service replica.
XUANJI_RUNS_ROOT=/var/lib/xuanji/runs
XUANJI_TASKS_ROOT=/var/lib/xuanji/tasks
XUANJI_RESULTS_ROOT=/var/lib/xuanji/results
